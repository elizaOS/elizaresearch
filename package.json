{
  "name": "@elizaos/elizaresearch-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static company site for elizaresearch.ai",
  "scripts": {
    "preview": "wrangler dev --port 4173",
    "deploy": "wrangler deploy",
    "mail:security": "node ./mail-security.mjs",
    "test": "bun test ./lifecycle-alpha.test.mjs ./mail-security.test.mjs",
    "deploy:check": "wrangler deploy --dry-run",
    "deck:check": "node deck/scripts/check.mjs && node --check deck/public/deck.js",
    "deck:preview": "wrangler dev --config deck/wrangler.toml --port 4184",
    "deck:deploy:check": "bun run deck:check && wrangler deploy --config deck/wrangler.toml --dry-run",
    "deck:deploy": "bun run deck:check && wrangler deploy --config deck/wrangler.toml",
    "deck:verify": "node deck/scripts/verify-live.mjs"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.15.0",
    "bun": "1.3.14"
  },
  "devDependencies": {
    "wrangler": "4.122.0"
  }
}
